<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrismExtensionServices.Shared\PrismExtensionServices.Shared.csproj" />
  </ItemGroup>


  <Target Name="CopyToHostPlugins" AfterTargets="Build">
    <PropertyGroup>
      <HostPluginsDir>$(MSBuildThisFileDirectory)..\PrismExtensionServices\bin\$(Configuration)\net10.0-windows\plugins\</HostPluginsDir>
    </PropertyGroup>
    <ItemGroup>
      <!-- Copy plugin output but exclude the shared contract assembly — the host already provides it -->
      <PluginOutput Include="$(OutputPath)*.*" Exclude="$(OutputPath)PrismExtensionServices.Shared.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginOutput)" DestinationFolder="$(HostPluginsDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
